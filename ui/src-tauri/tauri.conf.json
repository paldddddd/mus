{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wallmus-ui",
  "version": "0.1.0",
  "identifier": "com.wallmus.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wallmus — Live Wallpapers & Music",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "wallmus Widget",
        "width": 380,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
